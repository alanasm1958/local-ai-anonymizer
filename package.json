{
  "name": "ae-extension-local-anonymizer",
  "version": "0.4.0",
  "description": "Browser extension that anonymizes sensitive text with a local model before it reaches AI tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" \"tests/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\"",
    "eval": "node scripts/eval-ner.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "test:scenarios": "node --test --test-concurrency=1 tests/e2e/scenarios.e2e.js",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "lint": "eslint .",
    "package": "node scripts/package.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "stress": "node scripts/stress.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@huggingface/transformers": "^4.3.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}

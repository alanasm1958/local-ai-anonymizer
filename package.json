{
  "name": "ae-extension-local-anonymizer",
  "version": "0.1.0",
  "description": "Browser extension that anonymizes sensitive text with a local model before it reaches AI tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/core/**' 'tests/**/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'tests/e2e/*.e2e.js'",
    "eval": "node scripts/eval-ner.mjs",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "playwright-core": "^1.64.1"
  }
}
